{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  // Folder disebut satu per satu, bukan "**/*". Pola menyapu itu ikut mengompilasi
  // berkas .ts di folder mana pun di bawah akar proyek — termasuk salinan proyek yang
  // tidak sengaja tersimpan di dalamnya, misalnya sisa `git clone` yang bersarang.
  // Gejalanya menyesatkan: tsc melaporkan galat pada berkas yang jalurnya tidak dikenali
  // dan nomor barisnya tidak cocok dengan apa pun yang sedang dibuka.
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "*.ts",
    "*.mts",
    "*.mjs",
    "src/**/*.ts",
    "src/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.mjs",
    "prisma/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
