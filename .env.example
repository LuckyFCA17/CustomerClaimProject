# Salin ke .env lalu sesuaikan. .env tidak pernah di-commit.

# ── Database (cocok dengan docker-compose.yml) ──────────────────────────────
DATABASE_URL="postgresql://ncc:ncc@localhost:5432/ncc_portal?schema=public"

# ── Auth.js (Fase 1) ───────────────────────────────────────────────────────
# WAJIB diisi — login gagal seluruhnya selama nilainya kosong.
# `pnpm env:init` mengisinya otomatis; manual: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ── Aplikasi ───────────────────────────────────────────────────────────────
# Dipakai untuk deep link "Open in portal" di email (§8).
APP_URL="http://localhost:3000"
APP_TIMEZONE="Asia/Jakarta"

# ── Penyimpanan berkas (Fase 4) ────────────────────────────────────────────
# Diabstraksi lewat lib/storage.ts agar bisa diganti S3/MinIO tanpa ubah pemanggil.
STORAGE_DRIVER="local"
STORAGE_ROOT="./storage/uploads"

# ── SMTP (Fase 3 — MailHog di pengembangan) ────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="NCC Portal <ncc-portal@nifco.co.id>"
